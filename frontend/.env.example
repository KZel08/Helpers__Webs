# API endpoint
VITE_API_URL=http://localhost:3000/api

# Application name (shown in the UI)
VITE_APP_NAME="Helpers Pro"

# Geoapify Geocoding/Autocomplete API key (client-side safe when restricted by
# allowed domains/referrers in the Geoapify dashboard). Used by the location
# service abstraction in frontend/src/lib/location.ts. Leave blank to disable
# forward search/autocomplete and use the browser's native geolocation for
# current-location only.
VITE_GEOAPIFY_API_KEY=

# Razorpay key id (public, client-side safe)
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
